{
  "name": "crm-backend",
  "version": "1.0.0",
  "description": "Production-grade, optimized CRM Backend API with clean architecture",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/scripts/seed.js",
