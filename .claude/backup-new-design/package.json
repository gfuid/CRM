{
  "name": "crm-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:admin": "npm --prefix admin run dev",
    "start:backend": "npm --prefix backend start",
    "test": "npm --prefix backend test",
    "build": "npm run build:frontend && npm run build:admin",
    "build:frontend": "npm --prefix frontend run build",
    "build:admin": "npm --prefix admin run build",
    "test:all": "npm test && npm run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install && npm --prefix admin install"
  }
}
